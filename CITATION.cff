cff-version: 1.2.0
message: "Repository citation metadata (see authorship note: final manuscript author list of 5 contributors and corresponding-author designation await co-author approval prior to submission)."
title: "SARcasmScope: A Calibrated Feature-Fusion Framework for Context-Aware Sarcasm Detection in Multilingual and Code-Mixed Text"
version: 2.0.0
date-released: 2026-11-10
authors:
  - family-names: "Mehta"
    given-names: "Payal"
    email: "payal.12620246@vit.edu"
